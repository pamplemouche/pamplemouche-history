# 2026-07-27 17:22:34.076877
+<!DOCTYPE html>
+<html lang="fr">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Pax Historia - Clone</title>
+    <style>
+        body {
+            font-family: 'Times New Roman', serif;
+            background-color: #1a1a1a;
+            color: #e0e0e0;
+            margin: 0;
+            display: flex;
+            flex-direction: column;
+            height: 100vh;
+        }
+        #setup {
+            padding: 20px;
+            text-align: center;
+        }
+        #game-container {
+            display: none;
+            flex: 1;
+            flex-direction: column;
+            max-width: 800px;
+            margin: 0 auto;
+            width: 100%;
+            padding: 20px;
+        }
+        #stats {
+            display: flex;
+            justify-content: space-around;
+            background: #2c2c2c;
+            padding: 10px;
+            border-radius: 8px;
+            margin-bottom: 20px;
+        }
+        .stat-item { text-align: center; }
+        #narrative {
+            flex: 1;
+            background: #252525;
+            padding: 20px;
+            border-radius: 8px;
+            overflow-y: auto;
+            border: 1px solid #444;
+            margin-bottom: 20px;
+        }
+        #choices {
+            display: grid;
+            gap: 10px;
+        }
+        button {
+            padding: 12px;
+            background: #4a3b2b;
+            color: white;
+            border: none;
+            border-radius: 4px;
+            cursor: pointer;
+            transition: background 0.3s;
+        }
+        button:hover { background: #634e3a; }
+        button:disabled { background: #333; cursor: not-allowed; }
+        input {
+            padding: 10px;
+            width: 300px;
+            margin-bottom: 10px;
+        }
+    </style>
+</head>
+<body>
+
+<div id="setup">
+    <h1>Pax Historia AI</h1>
+    <p>Entrez votre clé API OpenAI pour commencer votre dynastie :</p>
+    <input type="password" id="api-key" placeholder="sk-...">
+    <br>
+    <button onclick="startGame()">Commencer l'Histoire</button>
+</div>
+
+<div id="game-container">
+    <div id="stats">
+        <div class="stat-item">Année<br><span id="year">1000</span></div>
+        <div class="stat-item">Stabilité<br><span id="stability">70</span>%</div>
+        <div class="stat-item">Trésor<br><span id="gold">500</span></div>
+        <div class="stat-item">Prestige<br><span id="prestige">10</span></div>
+    </div>
+    <div id="narrative">
+        Bienvenue, Souverain. Votre règne commence...
+    </div>
+    <div id="choices">
+        <!-- Les boutons de choix seront injectés ici -->
+    </div>
+</div>
+
+<script>
+    let state = {
+        year: 1000,
+        stability: 70,
+        gold: 500,
+        prestige: 10,
+        history: []
+    };
+
+    let apiKey = "";
+
+    function startGame() {
+        apiKey = document.getElementById('api-key').value;
+        if (!apiKey) return alert("Clé API requise");
+        document.getElementById('setup').style.display = 'none';
+        document.getElementById('game-container').style.display = 'flex';
+        nextTurn();
+    }
+
+    async function nextTurn() {
+        const narrativeDiv = document.getElementById('narrative');
+        const choicesDiv = document.getElementById('choices');
+        choicesDiv.innerHTML = "Génération de l'événement...";
+
+        const prompt = `Nous sommes en l'an ${state.year}. Je suis le dirigeant d'un royaume. 
+        Stats: Stabilité ${state.stability}%, Or ${state.gold}, Prestige ${state.prestige}.
+        Génère un événement historique complexe avec 3 choix possibles. 
+        Réponds uniquement en JSON format: {"event": "...", "choices": [{"text": "...", "impact": {"gold": 0, "stability": 0, "prestige": 0}}]}`;
+
+        try {
+            const response = await fetch('https://api.openai.com/v1/chat/completions', {
+                method: 'POST',
+                headers: {
+                    'Content-Type': 'application/json',
+                    'Authorization': `Bearer ${apiKey}`
+                },
+                body: JSON.stringify({
+                    model: "gpt-3.5-turbo",
+                    messages: [{role: "user", content: prompt}],
+                    response_format: { type: "json_object" }
+                })
+            });
+
+            const data = await response.json();
+            const content = JSON.parse(data.choices[0].message.content);
+            
+            displayEvent(content);
+        } catch (error) {
+            narrativeDiv.innerHTML += "<br>Erreur de communication avec l'IA.";
+            console.error(error);
+        }
+    }
+
+    function displayEvent(data) {
+        const narrativeDiv = document.getElementById('narrative');
+        const choicesDiv = document.getElementById('choices');
+        
+        narrativeDiv.innerHTML = `<p><strong>An ${state.year}</strong></p><p>${data.event}</p>`;
+        choicesDiv.innerHTML = "";
+
+        data.choices.forEach(choice => {
+            const btn = document.createElement('button');
+            btn.innerText = choice.text;
+            btn.onclick = () => applyChoice(choice);
+            choicesDiv.appendChild(btn);
+        });
+    }
+
+    function applyChoice(choice) {
+        state.year += Math.floor(Math.random() * 10) + 1;
+        state.gold += choice.impact.gold || 0;
+        state.stability += choice.impact.stability || 0;
+        state.prestige += choice.impact.prestige || 0;
+
+        // Clamp stats
+        state.stability = Math.max(0, Math.min(100, state.stability));
+
+        updateUI();
+        if (state.stability <= 0) {
+            alert("Votre royaume a sombré dans le chaos. Fin de la dynastie.");
+            location.reload();
+        } else {
+            nextTurn();
+        }
+    }
+
+    function updateUI() {
+        document.getElementById('year').innerText = state.year;
+        document.getElementById('stability').innerText = state.stability;
+        document.getElementById('gold').innerText = state.gold;
+        document.getElementById('prestige').innerText = state.prestige;
+    }
+</script>
+
+</body>
+</html>

